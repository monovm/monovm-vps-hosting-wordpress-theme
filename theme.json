{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "background": {
      "backgroundImage": false,
      "backgroundSize": false
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#061412",
          "name": "Canvas",
          "slug": "canvas"
        },
        {
          "color": "#0D2B29",
          "name": "Surface",
          "slug": "surface"
        },
        {
          "color": "#123936",
          "name": "Surface Alternate",
          "slug": "surface-alt"
        },
        {
          "color": "#EDF8F8",
          "name": "Ink",
          "slug": "ink"
        },
        {
          "color": "#A9C9C8",
          "name": "Muted",
          "slug": "muted"
        },
        {
          "color": "#5B8783",
          "name": "Line",
          "slug": "line"
        },
        {
          "color": "#1ADBDC",
          "name": "Signal",
          "slug": "signal"
        },
        {
          "color": "#FF4D62",
          "name": "Action",
          "slug": "action"
        },
        {
          "color": "#4ED17B",
          "name": "Positive",
          "slug": "positive"
        },
        {
          "color": "#FFA200",
          "name": "Warning",
          "slug": "warning"
        },
        {
          "color": "#FFD43B",
          "name": "Focus",
          "slug": "focus"
        }
      ]
    },
    "custom": {
      "border": {
        "width": "1px"
      },
      "focus": {
        "offset": "3px",
        "width": "2px"
      },
      "label": {
        "fontFamily": "var:preset|font-family|technical",
        "letterSpacing": "0.08em"
      },
      "radius": {
        "medium": "8px",
        "panel": "4px",
        "pill": "999px",
        "small": "4px"
      },
      "spacing": {
        "control": {
          "block": "0.75rem",
          "inline": "1.25rem"
        }
      }
    },
    "dimensions": {
      "minHeight": true
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "position": {
      "sticky": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "None",
          "shadow": "none",
          "slug": "none"
        },
        {
          "name": "Featured",
          "shadow": "none",
          "slug": "featured"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "2X Small",
          "size": "0.25rem",
          "slug": "20"
        },
        {
          "name": "X Small",
          "size": "0.5rem",
          "slug": "30"
        },
        {
          "name": "Small",
          "size": "0.75rem",
          "slug": "40"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "50"
        },
        {
          "name": "Large",
          "size": "1.5rem",
          "slug": "60"
        },
        {
          "name": "X Large",
          "size": "2rem",
          "slug": "70"
        },
        {
          "name": "2X Large",
          "size": "clamp(3rem, 6vw, 4rem)",
          "slug": "80"
        },
        {
          "name": "Section",
          "size": "clamp(4.5rem, 9vw, 9rem)",
          "slug": "90"
        },
        {
          "name": "2X Section",
          "size": "clamp(6rem, 12vw, 8rem)",
          "slug": "100"
        },
        {
          "name": "Gutter",
          "size": "clamp(1.25rem, 3vw, 3rem)",
          "slug": "gutter"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFace": [
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "100 700",
              "src": [
                "file:./assets/fonts/ibm-plex-sans-var-latin1.woff2"
              ]
            }
          ],
          "fontFamily": "\"IBM Plex Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "fontFace": [
            {
              "fontFamily": "IBM Plex Mono",
              "fontStyle": "normal",
              "fontWeight": "100 700",
              "src": [
                "file:./assets/fonts/ibm-plex-mono-var-latin1.woff2"
              ]
            }
          ],
          "fontFamily": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
          "name": "Technical",
          "slug": "technical"
        },
        {
          "fontFamily": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
          "name": "Mono",
          "slug": "mono"
        },
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
          "name": "System Sans",
          "slug": "system"
        }
      ],
      "fontSizes": [
        {
          "name": "Micro",
          "size": "0.75rem",
          "slug": "micro"
        },
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "clamp(1rem, 0.96rem + 0.2vw, 1.125rem)",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)",
          "slug": "large"
        },
        {
          "name": "X Large",
          "size": "clamp(1.5rem, 1.3rem + 1vw, 2rem)",
          "slug": "x-large"
        },
        {
          "name": "2X Large",
          "size": "clamp(2.25rem, 1.65rem + 3vw, 3.75rem)",
          "slug": "2-x-large"
        },
        {
          "name": "3X Large",
          "size": "clamp(3rem, 2rem + 5vw, 5.5rem)",
          "slug": "3-x-large"
        }
      ],
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|ink"
    },
    "elements": {
      "button": {
        ":active": {
          "color": {
            "background": "var:preset|color|ink",
            "text": "var:preset|color|canvas"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|signal",
            "text": "var:preset|color|canvas"
          }
        },
        "border": {
          "radius": "var(--wp--custom--radius--small)",
          "width": "0"
        },
        "color": {
          "background": "var:preset|color|action",
          "text": "var:preset|color|canvas"
        },
        "spacing": {
          "padding": {
            "bottom": "var:preset|spacing|40",
            "left": "var:preset|spacing|60",
            "right": "var:preset|spacing|60",
            "top": "var:preset|spacing|40"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "650",
          "lineHeight": "1.3",
          "textDecoration": "none"
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.5"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|3-x-large"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|2-x-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "fontWeight": "600",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.08"
        }
      },
      "link": {
        ":hover": {
          "color": {
            "text": "var:preset|color|ink"
          }
        },
        "color": {
          "text": "var:preset|color|signal"
        },
        "typography": {
          "textDecoration": "underline"
        }
      }
    },
    "spacing": {
      "blockGap": "var:preset|spacing|50",
      "padding": {
        "left": "var:preset|spacing|gutter",
        "right": "var:preset|spacing|gutter"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|primary",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.65"
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "var(--wp--custom--radius--small)"
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "var:preset|spacing|40"
        }
      },
      "core/code": {
        "border": {
          "color": "var:preset|color|line",
          "radius": "var(--wp--custom--radius--small)",
          "style": "solid",
          "width": "var(--wp--custom--border--width)"
        },
        "color": {
          "background": "var:preset|color|surface-alt",
          "text": "var:preset|color|ink"
        },
        "spacing": {
          "padding": {
            "bottom": "var:preset|spacing|60",
            "left": "var:preset|spacing|60",
            "right": "var:preset|spacing|60",
            "top": "var:preset|spacing|60"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|technical",
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.65"
        }
      },
      "core/cover": {
        "border": {
          "radius": "var(--wp--custom--radius--medium)"
        }
      },
      "core/details": {
        "border": {
          "color": "var:preset|color|line",
          "radius": "var(--wp--custom--radius--small)",
          "style": "solid",
          "width": "var(--wp--custom--border--width)"
        },
        "spacing": {
          "padding": {
            "bottom": "var:preset|spacing|50",
            "left": "var:preset|spacing|60",
            "right": "var:preset|spacing|60",
            "top": "var:preset|spacing|50"
          }
        }
      },
      "core/gallery": {
        "spacing": {
          "blockGap": "var:preset|spacing|30"
        }
      },
      "core/image": {
        "border": {
          "radius": "var(--wp--custom--radius--medium)"
        }
      },
      "core/navigation": {
        "elements": {
          "link": {
            ":hover": {
              "color": {
                "text": "var:preset|color|signal"
              }
            },
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|technical",
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|muted"
        }
      },
      "core/post-template": {
        "spacing": {
          "blockGap": "var:preset|spacing|70"
        }
      },
      "core/preformatted": {
        "border": {
          "color": "var:preset|color|line",
          "radius": "var(--wp--custom--radius--small)",
          "style": "solid",
          "width": "var(--wp--custom--border--width)"
        },
        "color": {
          "background": "var:preset|color|surface",
          "text": "var:preset|color|ink"
        },
        "spacing": {
          "padding": {
            "bottom": "var:preset|spacing|60",
            "left": "var:preset|spacing|60",
            "right": "var:preset|spacing|60",
            "top": "var:preset|spacing|60"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|technical",
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/quote": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.5"
        }
      },
      "core/search": {
        "elements": {
          "button": {
            "border": {
              "radius": "var(--wp--custom--radius--small)"
            }
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|line"
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/site-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "700",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.1"
        }
      },
      "core/social-links": {
        "spacing": {
          "blockGap": "var:preset|spacing|30"
        }
      },
      "core/table": {
        "border": {
          "color": "var:preset|color|line"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-no-title",
      "postTypes": [
        "page"
      ],
      "title": "Page without title"
    },
    {
      "name": "blank",
      "postTypes": [
        "page"
      ],
      "title": "Blank / Landing"
    }
  ],
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "header",
      "name": "header-minimal",
      "title": "Minimal header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    },
    {
      "area": "footer",
      "name": "footer-minimal",
      "title": "Minimal footer"
    }
  ]
}
