{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "High Contrast",
  "settings": {
    "color": {
      "palette": [
        { "color": "#FFFFFF", "name": "Canvas", "slug": "canvas" },
        { "color": "#FFFFFF", "name": "Surface", "slug": "surface" },
        { "color": "#F2F2F2", "name": "Surface Alternate", "slug": "surface-alt" },
        { "color": "#000000", "name": "Ink", "slug": "ink" },
        { "color": "#000000", "name": "Muted", "slug": "muted" },
        { "color": "#000000", "name": "Line", "slug": "line" },
        { "color": "#005A5B", "name": "Signal", "slug": "signal" },
        { "color": "#000000", "name": "Action", "slug": "action" },
        { "color": "#006B2E", "name": "Positive", "slug": "positive" },
        { "color": "#8A4600", "name": "Warning", "slug": "warning" },
        { "color": "#005FCC", "name": "Focus", "slug": "focus" }
      ]
    },
    "custom": {
      "border": { "width": "2px" },
      "focus": { "offset": "3px", "width": "3px" },
      "label": {
        "fontFamily": "var:preset|font-family|system",
        "letterSpacing": "0.04em"
      },
      "radius": {
        "medium": "0",
        "panel": "0",
        "pill": "0",
        "small": "0"
      },
      "spacing": {
        "control": { "block": "1rem", "inline": "1.5rem" }
      }
    },
    "shadow": {
      "presets": [
        { "name": "None", "shadow": "none", "slug": "none" },
        { "name": "Featured", "shadow": "none", "slug": "featured" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "name": "2X Small", "size": "0.375rem", "slug": "20" },
        { "name": "X Small", "size": "0.625rem", "slug": "30" },
        { "name": "Small", "size": "1rem", "slug": "40" },
        { "name": "Medium", "size": "1.25rem", "slug": "50" },
        { "name": "Large", "size": "2rem", "slug": "60" },
        { "name": "X Large", "size": "2.75rem", "slug": "70" },
        { "name": "2X Large", "size": "clamp(3.5rem, 7vw, 5.5rem)", "slug": "80" },
        { "name": "Section", "size": "clamp(5rem, 10vw, 10rem)", "slug": "90" },
        { "name": "2X Section", "size": "clamp(7rem, 13vw, 10rem)", "slug": "100" },
        { "name": "Gutter", "size": "clamp(1.25rem, 3.5vw, 3.5rem)", "slug": "gutter" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
          "name": "Primary System Sans",
          "slug": "primary"
        },
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
          "name": "Technical System Sans",
          "slug": "technical"
        },
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
          "name": "Mono System Sans",
          "slug": "mono"
        },
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
          "name": "System Sans",
          "slug": "system"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|ink"
    },
    "elements": {
      "button": {
        ":hover": {
          "color": {
            "background": "var:preset|color|signal",
            "text": "var:preset|color|canvas"
          }
        },
        "border": {
          "color": "var:preset|color|ink",
          "radius": "0",
          "style": "solid",
          "width": "2px"
        },
        "color": {
          "background": "var:preset|color|action",
          "text": "var:preset|color|canvas"
        },
        "spacing": {
          "padding": {
            "bottom": "var:preset|spacing|40",
            "left": "var:preset|spacing|60",
            "right": "var:preset|spacing|60",
            "top": "var:preset|spacing|40"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|system",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "700"
        }
      },
      "caption": {
        "color": { "text": "var:preset|color|ink" }
      },
      "heading": {
        "color": { "text": "var:preset|color|ink" },
        "typography": {
          "fontFamily": "var:preset|font-family|system",
          "fontWeight": "700",
          "letterSpacing": "0",
          "lineHeight": "1.15"
        }
      },
      "link": {
        "color": { "text": "var:preset|color|ink" },
        "typography": { "textDecoration": "underline" }
      }
    },
    "spacing": { "blockGap": "var:preset|spacing|50" },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "1.125rem",
      "lineHeight": "1.7"
    },
    "blocks": {
      "core/code": {
        "border": {
          "color": "var:preset|color|ink",
          "radius": "0",
          "style": "solid",
          "width": "2px"
        },
        "color": {
          "background": "var:preset|color|surface-alt",
          "text": "var:preset|color|ink"
        },
        "typography": { "fontFamily": "var:preset|font-family|system" }
      },
      "core/details": {
        "border": {
          "color": "var:preset|color|ink",
          "radius": "0",
          "style": "solid",
          "width": "2px"
        },
        "spacing": {
          "padding": {
            "bottom": "var:preset|spacing|60",
            "left": "var:preset|spacing|60",
            "right": "var:preset|spacing|60",
            "top": "var:preset|spacing|60"
          }
        }
      },
      "core/navigation": {
        "elements": {
          "link": {
            "color": { "text": "var:preset|color|ink" },
            "typography": { "textDecoration": "underline" }
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|system",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "700"
        }
      },
      "core/post-date": {
        "color": { "text": "var:preset|color|ink" },
        "typography": { "fontFamily": "var:preset|font-family|system" }
      },
      "core/post-excerpt": {
        "color": { "text": "var:preset|color|ink" }
      },
      "core/table": {
        "border": { "color": "var:preset|color|ink" }
      }
    }
  }
}
